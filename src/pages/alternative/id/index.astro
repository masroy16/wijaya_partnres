---
import AlternativePage from '../../../components/alternative/AlternativePage.astro';
import { getAlternativeContent } from '../../../content/alternative';
import AlternativeLayout from '../../../layouts/AlternativeLayout.astro';

const content = getAlternativeContent('id');
---

<AlternativeLayout lang="id" title={content.meta.title} description={content.meta.description}>
  <div class="concept-ribbon"><span>{content.previewLabel}</span></div>
  <AlternativePage content={content} />
</AlternativeLayout>
