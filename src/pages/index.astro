---
import { Image } from 'astro:assets';
import { REVIEW_CONCEPTS } from '../content/review';
import ReviewLayout from '../layouts/ReviewLayout.astro';

const title = 'Internal Design Review';
const description = 'Pemilihan konsep internal untuk review desain Wijaya And Partners.';
---

<ReviewLayout {title} {description}>
  <main class="review-portal__main">
    <header class="review-portal__intro">
      <p class="review-portal__eyebrow">Design review workspace</p>
      <h1>Internal Design Review</h1>
      <p class="review-portal__notice">
        Halaman ini hanya untuk memilih konsep dan bukan bagian dari website Wijaya And Partners.
      </p>
    </header>

    <section class="review-portal__grid" aria-label="Pilihan konsep desain">
      {REVIEW_CONCEPTS.map((concept) => (
        <article class="review-card" data-review-card={concept.id}>
          <div class="review-card__preview" data-review-thumbnail>
            <Image
              src={concept.thumbnail}
              alt={concept.thumbnailAlt}
              widths={[480, 720, 960]}
              sizes="(min-width: 48rem) 42vw, 100vw"
              loading="eager"
            />
          </div>
          <div class="review-card__body">
            <h2>{concept.title}</h2>
            <div class="review-card__links" aria-label={`Buka ${concept.title}`}>
              {concept.links.map((link) => (
                <a href={link.href} lang={link.locale}>{link.label}</a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </section>
  </main>
</ReviewLayout>
