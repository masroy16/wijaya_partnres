---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getHomeContent } from '../../content/home';
import type { Locale, SectionId } from '../../i18n/types';

export function getStaticPaths() {
  return [{ params: { lang: 'id' } }, { params: { lang: 'en' } }];
}

const locale = Astro.params.lang as Locale;
const content = getHomeContent(locale);
const pathname = `/${locale}/`;
const sections: ReadonlyArray<{ id: Exclude<SectionId, 'hero'>; headline: string; body: string }> = [
  { id: 'legacy', headline: content.legacy.headline, body: content.legacy.paragraphs[0] },
  { id: 'expertise', headline: content.expertise.headline, body: content.expertise.introduction },
  { id: 'ethics', headline: content.ethics.headline, body: content.ethics.introduction },
  { id: 'team', headline: content.team.headline, body: content.team.introduction },
  { id: 'clients', headline: content.clients.headline, body: content.clients.introduction },
  { id: 'contact', headline: content.contact.headline, body: content.contact.introduction },
];
---

<BaseLayout
  locale={locale}
  title={content.meta.title}
  description={content.meta.description}
  pathname={pathname}
>
  <main id="main-content" tabindex="-1">
    <section id="hero" class="shell-section" aria-labelledby="hero-title">
      <h1 id="hero-title">{content.hero.headline}</h1>
      <p>{content.hero.body}</p>
    </section>

    {sections.map(({ id, headline, body }) => (
      <section id={id} class="shell-section" aria-labelledby={`${id}-title`}>
        <h2 id={`${id}-title`}>{headline}</h2>
        <p>{body}</p>
      </section>
    ))}
  </main>
</BaseLayout>
