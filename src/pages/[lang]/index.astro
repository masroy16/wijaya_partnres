---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getHomeContent } from '../../content/home';
import type { Locale, SectionId } from '../../i18n/types';
import HeroSection from '../../components/sections/HeroSection.astro';
import LegacySection from '../../components/sections/LegacySection.astro';
import ExpertiseSection from '../../components/sections/ExpertiseSection.astro';
import EthicsSection from '../../components/sections/EthicsSection.astro';
import TeamSection from '../../components/sections/TeamSection.astro';
import { getTeamMembers } from '../../content/team';

export function getStaticPaths() {
  return [{ params: { lang: 'id' } }, { params: { lang: 'en' } }];
}

const locale = Astro.params.lang as Locale;
const content = getHomeContent(locale);
const teamMembers = getTeamMembers(locale);
const pathname = `/${locale}/`;
const remainingSections: ReadonlyArray<{
  id: Exclude<SectionId, 'hero' | 'legacy' | 'expertise' | 'ethics'>;
  headline: string;
  body: string;
}> = [
  { id: 'clients', headline: content.clients.headline, body: content.clients.introduction },
  { id: 'contact', headline: content.contact.headline, body: content.contact.introduction },
];
---

<BaseLayout
  locale={locale}
  title={content.meta.title}
  description={content.meta.description}
  pathname={pathname}
>
  <main id="main-content" tabindex="-1">
    <HeroSection locale={locale} content={content.hero} />
    <LegacySection locale={locale} content={content.legacy} />
    <ExpertiseSection locale={locale} content={content.expertise} />
    <EthicsSection locale={locale} content={content.ethics} />
    <TeamSection locale={locale} content={content.team} members={teamMembers} />

    {remainingSections.map(({ id, headline, body }) => (
      <section id={id} class="shell-section" aria-labelledby={`${id}-title`}>
        <h2 id={`${id}-title`}>{headline}</h2>
        <p>{body}</p>
      </section>
    ))}
  </main>
</BaseLayout>
