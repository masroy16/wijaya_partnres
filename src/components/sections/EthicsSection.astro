---
import { Image } from 'astro:assets';
import ethicsImage from '../../assets/sections/ethics-stone.webp';
import type { HomeContent, Locale } from '../../i18n/types';

interface Props {
  locale: Locale;
  content: HomeContent['ethics'];
}

const { locale, content } = Astro.props;
const eyebrow = locale === 'id' ? 'Cara kami bekerja' : 'How we work';
---

<section id="ethics" class="ethics" aria-labelledby="ethics-title" data-section-reveal>
  <Image
    class="ethics__image"
    src={ethicsImage}
    alt=""
    widths={[640, 960, 1440]}
    sizes="100vw"
    loading="lazy"
    data-narrative-image
  />
  <div class="ethics__wash" aria-hidden="true"></div>
  <div class="ethics__content" data-section-content>
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="ethics-title">{content.headline}</h2>
      <p class="ethics__intro">{content.introduction}</p>
    </div>
    <ul class="ethics__values">
      {content.values.map((value) => (
        <li><span aria-hidden="true"></span>{value}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ethics {
    position: relative;
    padding-block: clamp(7rem, 12vw, 11rem);
    overflow: hidden;
    isolation: isolate;
    color: #171414;
  }

  .ethics__image,
  .ethics__wash {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ethics__wash {
    z-index: -1;
    background: rgb(250 248 244 / 78%);
  }

  .ethics__content {
    width: min(var(--content-width), calc(100% - 2rem));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(23rem, 0.8fr);
    gap: clamp(4rem, 10vw, 10rem);
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: #7a1f25;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 6rem);
    line-height: 0.96;
    letter-spacing: var(--tracking-display);
  }

  .ethics__intro {
    max-width: 46rem;
    margin-top: 2rem;
    color: #56504d;
    font-size: clamp(1rem, 1.8vw, 1.2rem);
  }

  .ethics__values {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(23 20 20 / 24%);
  }

  .ethics__values li {
    min-height: 4.65rem;
    padding-block: 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid rgb(23 20 20 / 24%);
    font-weight: 720;
  }

  .ethics__values span {
    width: 0.62rem;
    height: 0.62rem;
    flex: 0 0 auto;
    border: 2px solid #7a1f25;
    transform: rotate(45deg);
  }

  @media (max-width: 55rem) {
    .ethics__content {
      grid-template-columns: 1fr;
    }
  }
</style>
