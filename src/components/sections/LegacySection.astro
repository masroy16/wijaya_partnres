---
import { Image } from 'astro:assets';
import legacyImage from '../../assets/sections/legacy-law-book.webp';
import type { HomeContent, Locale } from '../../i18n/types';

interface Props {
  locale: Locale;
  content: HomeContent['legacy'];
}

const { locale, content } = Astro.props;
const eyebrow = locale === 'id' ? 'Warisan kami' : 'Our legacy';
const foundingYear = '1988';
---

<section id="legacy" class="legacy" aria-labelledby="legacy-title">
  <div class="legacy__grid">
    <div class="legacy__content">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="legacy-title">{content.headline}</h2>
      <div class="legacy__copy">
        {content.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <p class="legacy__year" aria-label={`${locale === 'id' ? 'Didirikan' : 'Founded'} ${foundingYear}`}>
        <span aria-hidden="true">{foundingYear}</span>
      </p>
    </div>
    <div class="legacy__visual">
      <Image
        src={legacyImage}
        alt=""
        widths={[480, 720, 960]}
        sizes="(max-width: 55rem) 100vw, 46vw"
        loading="lazy"
        data-narrative-image
      />
    </div>
  </div>
</section>

<style>
  .legacy {
    padding-block: clamp(6rem, 12vw, 11rem);
    background: var(--color-canvas);
  }

  .legacy__grid {
    width: min(var(--content-width), calc(100% - 2rem));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-burgundy-700);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 6rem);
    line-height: 0.96;
    letter-spacing: -0.06em;
  }

  .legacy__copy {
    max-width: 44rem;
    margin-top: 2.25rem;
    color: var(--color-ink-muted);
    font-size: clamp(1rem, 1.7vw, 1.16rem);
  }

  .legacy__copy p + p {
    margin-top: 1.1rem;
  }

  .legacy__year {
    margin: 2.5rem 0 0;
    color: var(--color-burgundy-700);
    font-family: var(--font-serif);
    font-size: clamp(3rem, 7vw, 6.5rem);
    font-style: italic;
    line-height: 1;
  }

  .legacy__visual {
    position: relative;
    min-height: 34rem;
    overflow: hidden;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-floating);
  }

  .legacy__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgb(19 12 10 / 28%));
    pointer-events: none;
  }

  .legacy__visual :global(img) {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    object-fit: cover;
  }

  @media (max-width: 55rem) {
    .legacy__grid {
      grid-template-columns: 1fr;
    }

    .legacy__visual {
      min-height: min(34rem, 78vw);
      order: -1;
    }
  }
</style>
