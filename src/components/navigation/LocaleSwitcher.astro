---
import { getAlternatePath } from '../../i18n/routes';
import type { Locale } from '../../i18n/types';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const targetLocale: Locale = locale === 'id' ? 'en' : 'id';
const targetLabel = targetLocale === 'en' ? 'English' : 'Bahasa Indonesia';
const href = getAlternatePath(pathname, targetLocale);
---

<a class="locale-switcher" href={href} lang={targetLocale} hreflang={targetLocale}>
  <span aria-hidden="true">{targetLocale.toUpperCase()}</span>
  <span class="visually-hidden">{targetLabel}</span>
</a>

<style>
  .locale-switcher {
    min-width: 2.75rem;
    min-height: 2.75rem;
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-pill);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .locale-switcher:hover {
    border-color: var(--color-burgundy-600);
    color: var(--color-burgundy-700);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
