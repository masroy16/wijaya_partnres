---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ClientRecord } from '../../i18n/types';

interface Props {
  client: ClientRecord;
}

const { client } = Astro.props;
const imageModules = import.meta.glob<{ default: ImageMetadata }>('../../assets/clients/*', {
  eager: true,
});
const image = imageModules[`../../assets/clients/${client.sourceFile}`]?.default;
---

<article
  class="client-logo"
  data-client-card
  data-client-id={client.id}
  data-client-extra={!client.featured || undefined}
>
  <div class="client-logo__visual">
    {image ? (
      <Image
        src={image}
        alt={client.displayName}
        width={240}
        densities={[1, 2]}
        format="webp"
        quality={80}
        loading="lazy"
      />
    ) : (
      <span aria-hidden="true">{client.displayName.slice(0, 2).toUpperCase()}</span>
    )}
  </div>
  <p>{client.displayName}</p>
</article>

<style>
  .client-logo {
    min-width: 0;
    min-height: 10.5rem;
    padding: 1rem;
    display: grid;
    grid-template-rows: minmax(6.5rem, 1fr) auto;
    align-items: center;
    border: 1px solid var(--color-stone);
    border-radius: 1rem;
    background: #fff;
    color: #201d1d;
  }

  .client-logo[hidden] {
    display: none;
  }

  .client-logo__visual {
    min-height: 6.5rem;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .client-logo__visual :global(img) {
    max-width: 100%;
    max-height: 5.5rem;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.74;
    transition: filter var(--transition-fast), opacity var(--transition-fast);
  }

  .client-logo:hover .client-logo__visual :global(img) {
    filter: grayscale(0);
    opacity: 1;
  }

  .client-logo__visual > span {
    color: #7a1f25;
    font-family: var(--font-serif);
    font-size: 2rem;
    font-style: italic;
  }

  p {
    margin: 0.75rem 0 0;
    color: #625d59;
    font-size: 0.72rem;
    font-weight: 720;
    line-height: 1.3;
    text-align: center;
    overflow-wrap: anywhere;
  }
</style>
