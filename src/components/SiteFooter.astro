---
import type { HomeContent, Locale } from '../i18n/types';

interface Props {
  locale: Locale;
  content: HomeContent['footer'];
}

const { locale, content } = Astro.props;
const copyright = locale === 'id' ? 'Hak cipta dilindungi.' : 'All rights reserved.';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      <p class="site-footer__brand">Wijaya &amp; Partners</p>
      <p class="site-footer__preview">{content.previewLabel}</p>
    </div>
    <nav aria-label={locale === 'id' ? 'Navigasi footer' : 'Footer navigation'}>
      <a href={`/${locale}/#legacy`}>{locale === 'id' ? 'Tentang' : 'About'}</a>
      <a href={`/${locale}/#team`}>{locale === 'id' ? 'Tim' : 'Team'}</a>
      <a href={`/${locale}/#contact`}>{locale === 'id' ? 'Kontak' : 'Contact'}</a>
    </nav>
    <div class="site-footer__legal">
      <p>{content.disclaimer}</p>
      <p>© {year} Wijaya &amp; Partners. {copyright}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 3rem 0 6.5rem;
    border-top: 1px solid var(--color-stone);
    background: var(--color-canvas);
  }

  .site-footer__inner {
    width: min(var(--content-width), calc(100% - 2rem));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2.5rem;
  }

  .site-footer__brand {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.35rem;
  }

  .site-footer__preview {
    margin: 0.7rem 0 0;
    color: var(--color-burgundy-700);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: 1.25rem;
  }

  nav a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    color: var(--color-ink-muted);
    font-size: 0.88rem;
    font-weight: 700;
    text-underline-offset: 0.25rem;
  }

  .site-footer__legal {
    grid-column: 1 / -1;
    padding-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    border-top: 1px solid var(--color-stone);
    color: var(--color-ink-muted);
    font-size: 0.78rem;
  }

  .site-footer__legal p {
    max-width: 44rem;
    margin: 0;
  }

  @media (max-width: 42rem) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }

    .site-footer__legal {
      grid-column: auto;
      flex-direction: column;
    }
  }
</style>
