---
import { CONTACT } from '../content/contact';
import type { Locale } from '../i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const label = locale === 'id' ? 'Hubungi Wijaya And Partners melalui WhatsApp' : 'Contact Wijaya And Partners on WhatsApp';
---

<a
  class="floating-whatsapp"
  href={CONTACT.whatsappHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  title={label}
  data-floating-whatsapp
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.2 11.7a8.2 8.2 0 0 1-12.1 7.2L3.8 20l1.1-4.1a8.2 8.2 0 1 1 15.3-4.2Z"></path>
    <path d="M8.4 7.5c.2-.4.4-.4.7-.4h.6c.2 0 .4.1.5.4l.8 2c.1.3 0 .5-.2.7l-.6.7c.8 1.7 2.1 3 3.8 3.8l.7-.8c.2-.2.4-.3.7-.2l1.9.9c.3.1.4.3.4.6 0 .4-.2 1.3-.7 1.8-.5.5-1.4.8-2.2.6-4.8-.9-8.7-4.8-9.6-9.6-.2-.8.1-1.7.6-2.2.5-.5 1.4-.7 1.8-.7.3 0 .5.1.6.4Z"></path>
  </svg>
</a>

<style>
  .floating-whatsapp {
    position: fixed;
    z-index: 90;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    width: 3.65rem;
    height: 3.65rem;
    display: grid;
    place-items: center;
    border: 0.18rem solid #fff;
    border-radius: 50%;
    background: #21c566;
    color: #fff;
    box-shadow: 0 0.75rem 1.8rem rgb(0 0 0 / 24%);
    transition: transform var(--transition-fast);
  }

  .floating-whatsapp:hover {
    transform: translateY(-0.2rem);
  }

  svg {
    width: 1.85rem;
    height: 1.85rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 28rem) {
    .floating-whatsapp {
      right: max(0.65rem, env(safe-area-inset-right));
      bottom: max(0.65rem, env(safe-area-inset-bottom));
      width: 3.25rem;
      height: 3.25rem;
    }
  }
</style>
