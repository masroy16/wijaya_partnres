---
import type { TeamMember } from '../../i18n/types';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
const initials = member.name
  .replace(/^F\.\s*/i, 'F ')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0])
  .join('')
  .toUpperCase();
const profileLabel = member.locale === 'id' ? `Lihat profil ${member.name}` : `View ${member.name}'s profile`;
---

<article class="team-card" data-team-card>
  <a href={`/${member.locale}/team/${member.slug}/`} aria-label={profileLabel}>
    <div class="team-card__portrait" aria-hidden="true">
      <span>{initials}</span>
    </div>
    <div class="team-card__details">
      <p class="team-card__country">{member.country}</p>
      <h3 data-member-name>{member.name}</h3>
      <p class="team-card__credentials" data-member-credentials>{member.credentials}</p>
      <span class="team-card__arrow" aria-hidden="true">↗</span>
    </div>
  </a>
</article>

<style>
  .team-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: 0 0.4rem 1.5rem rgb(31 24 21 / 5%);
    transition: border-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .team-card:hover {
    border-color: var(--color-burgundy-600);
    box-shadow: var(--shadow-floating);
    transform: translateY(-0.25rem);
  }

  a {
    min-width: 0;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .team-card__portrait {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    border-bottom: 1px solid var(--color-stone);
    background:
      radial-gradient(circle at 75% 25%, color-mix(in srgb, var(--color-burgundy-100), transparent 25%), transparent 34%),
      linear-gradient(145deg, var(--color-surface), var(--color-canvas));
  }

  .team-card__portrait span {
    color: var(--color-burgundy-700);
    font-family: var(--font-serif);
    font-size: clamp(3rem, 7vw, 5.25rem);
    font-style: italic;
    letter-spacing: -0.08em;
  }

  .team-card__details {
    position: relative;
    min-width: 0;
    min-height: 12.5rem;
    padding: clamp(1.3rem, 3vw, 2rem);
  }

  .team-card__country {
    margin: 0 0 1.2rem;
    color: var(--color-ink-muted);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h3 {
    max-width: calc(100% - 2rem);
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .team-card__credentials {
    max-width: calc(100% - 1rem);
    margin: 0.65rem 0 0;
    color: var(--color-ink-muted);
    font-size: 0.92rem;
    overflow-wrap: anywhere;
  }

  .team-card__arrow {
    position: absolute;
    right: 1.4rem;
    bottom: 1.4rem;
    color: var(--color-burgundy-700);
    font-size: 1.3rem;
  }

  @media (min-width: 56.0625rem) {
    .team-card__portrait {
      aspect-ratio: 16 / 10;
    }

    .team-card__details {
      min-height: 10rem;
      padding: clamp(1.2rem, 2vw, 1.5rem);
    }
  }
</style>
